<!-- Modal de confirmation de suppression -->
<div class="modal fade" id="deleteModal{{ id }}" tabindex="-1" aria-labelledby="deleteModalLabel{{ id }}" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title" id="deleteModalLabel{{ id }}">
                    <i class="fas fa-exclamation-triangle text-warning"></i>
                    Confirmation de la suppression
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <div class="mb-3">
                    <i class="fas fa-trash-alt text-danger fa-3x mb-3"></i>
                    <p class="text-danger fw-bold fs-5">Êtes-vous sûr de vouloir supprimer cet élément ?</p>
                    <p class="text-muted">Cette action est irréversible.</p>
                </div>
            </div>
            <div class="modal-footer justify-content-center border-top-0">
                <form method="post" action="{{ path }}" class="d-inline">
                    {% if csrf_token is defined %}
                        <input type="hidden" name="_token" value="{{ csrf_token }}">
                    {% endif %}
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-check"></i> Oui, supprimer
                    </button>
                </form>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Annuler
                </button>
            </div>
        </div>
    </div>
</div>
