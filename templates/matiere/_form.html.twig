
    <div class="card card-primary">
    <div class="card-header">
        <h3 class="card-title">Créer une nouvelle matière</h3>
    </div>
    <form>
        <div class="card-body">
            <div class="form-group">
                <label for="matiere_titre">Titre de la matière</label>
