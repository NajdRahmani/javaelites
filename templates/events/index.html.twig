{% extends 'base.html.twig' %}

{% block title %}Our Events {% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/css/events.css') }}">
{% endblock %}
{% block body %}
    <h1>Events index</h1>

    <section class="light">
	<div class="container py-2">
		<div class="h1 text-center text-dark" id="pageHeaderTitle">Our Events</div>
    
        {% for event in events %}
		<article class="postcard light blue">
            <a class="postcard__img_link" href="{{ path('app_events_show', {'id': event.id}) }}">
                {% if event.image %}
                    <img class="postcard__img" src="{{ asset('uploads/events/' ~ event.image) }}" alt="{{ event.title }}">
                {% else %}
                    <p>No image available</p>
                {% endif %}
            </a>
            <div class="postcard__text t-dark">
                <h1 class="postcard__title blue">
                    <a href="{{ path('app_events_show', {'id': event.id}) }}">{{ event.title }}</a>
                </h1>
                <div class="postcard__subtitle small">
                    <time datetime="{{ event.startDate|date('Y-m-d H:i:s') }}">
                        <i class="fas fa-calendar-alt mr-2"></i>{{ event.startDate|date('D, M jS Y') }}
                    </time>
                </div>
                <div class="postcard__bar"></div>
                <div class="postcard__preview-txt">{{ event.description }}</div>
                <ul class="postcard__tagbox">
                    {% for category in event.category %}
                        {% if category != 'type' and category != 'free' %}
                            <li class="tag__item">{{ category }}</li>
                        {% endif %}
                    {% endfor %}
                </ul>

            </div>
        </article>

        {% else %}
            
        {% endfor %}
        </div>

    </div>

    <a href="{{ path('app_events_new') }}">Create new</a>
{% endblock %}
