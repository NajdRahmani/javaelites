{% extends 'base2.html.twig' %}

{% block title %}Détails de l'Énoncé de la Question{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet"> <!-- FontAwesome -->
    <link rel="stylesheet" href="{{ asset('assets/css/showquestion.css') }}">
{% endblock %}

{% block body %}
    <div class="container1">
        <h2 class="text-center mb-4">Détails de l'Énoncé de la Question</h2>

        <div class="card">
            <div class="card-body">
                <h5 class="card-title"><i class="fas fa-question-circle icon-btn"></i>{{ question.text }}</h5>
                <p class="card-text"><strong><i class="fas fa-star"></i> Points :</strong> {{ question.point }}</p>
            </div>

            <div class="card-footer">
                <a href="{{ path('app_question_edit', {'id': question.id}) }}" class="btn btn-warning btn-lg">
                    <i class="fas fa-edit icon-btn"></i>Modifier
                </a>
                <a href="{{ path('app_question_index', {'evaluationId': question.evaluation.id}) }}" class="btn btn-secondary btn-lg">
                    <i class="fas fa-arrow-left icon-btn"></i>Retour à la liste
                </a>
            </div>

            <div class="card-footer">
                <a href="{{ path('app_reponse_etudiants', {'id': question.evaluation.id}) }}" class="btn btn-info btn-lg">
                    <i class="fas fa-list icon-btn"></i> Voir les réponses des étudiants
                </a>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
