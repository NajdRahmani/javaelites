{% extends 'base2.html.twig' %}

{% block title %}Détails de la Question{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet"> <!-- FontAwesome -->
    <link rel="stylesheet" href="{{ asset('assets/css/showquestion.css') }}">
{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="card">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h2 class="card-title mb-0">Question {{ question.ordreQuestion }}</h2>
                <div>
                    <a href="{{ path('app_question_edit', {'id': question.id}) }}" class="btn btn-light me-2">
                        <i class="fas fa-edit"></i> Modifier
                    </a>
                    <a href="{{ path('app_evaluation_show', {'id': question.evaluation.id}) }}" class="btn btn-light">
                        <i class="fas fa-arrow-left"></i> Retour
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <h5>Énoncé :</h5>
                    <p class="card-text">{{ question.text }}</p>
                </div>

                <div class="mb-4">
                    <h5>Points :</h5>
                    <p class="card-text">{{ question.point }}</p>
                </div>

                <div class="mb-4">
                    <h5>Évaluation :</h5>
                    <p class="card-text">{{ question.evaluation.title }}</p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
