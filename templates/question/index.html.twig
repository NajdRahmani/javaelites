{% extends 'base3.html.twig' %}

{% block title %}Liste des Questions{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .question-text {
            max-width: 400px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .table td {
            vertical-align: middle;
        }
    </style>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="{{ asset('assets/css/indexquestion.css') }}">
{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Questions de l'évaluation</h1>
            {% if evaluation is not null %}
                <a href="{{ path('app_question_new', {'evaluationId': evaluation.id}) }}" class="btn btn-success">
                    <i class="fas fa-plus"></i> Nouvel Énoncé
                </a>
            {% else %}
                <p class="text-danger">Aucune évaluation sélectionnée. Impossible d'ajouter une nouvelle question.</p>
            {% endif %}
        </div>

        {% if evaluation %}
            <div class="alert alert-info">
                <h4>{{ evaluation.title }}</h4>
                <p>Score maximum : {{ evaluation.maxScore }} points</p>
            </div>
        {% endif %}

        <div class="card">
            <div class="card-body">
                <table class="table table-striped table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Points</th>
                            <th>Ordre</th>
                            <th style="width: 40%">Énoncé</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for question in questions|sort((a, b) => a.ordreQuestion <=> b.ordreQuestion) %}
                        <tr>
                            <td>{{ question.id }}</td>
                            <td>{{ question.point }}</td>
                            <td>{{ question.ordreQuestion }}</td>
                            <td>
                                <div class="question-text" title="{{ question.text }}">
                                    {{ question.text }}
                                </div>
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a href="{{ path('app_question_show', {'id': question.id}) }}" class="btn btn-info btn-sm">
                                        <i class="fas fa-eye"></i> Voir
                                    </a>
                                    <a href="{{ path('app_question_edit', {'id': question.id}) }}" class="btn btn-warning btn-sm">
                                        <i class="fas fa-edit"></i> Modifier
                                    </a>
                                    <form method="post" action="{{ path('app_question_delete', {'id': question.id}) }}" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet énoncé de question ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ question.id) }}">
                                        <button class="btn btn-danger btn-sm">
                                            <i class="fas fa-trash"></i> Supprimer
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center">Aucune question n'a été créée pour cette évaluation.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Activer les tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        })
    </script>
{% endblock %}
