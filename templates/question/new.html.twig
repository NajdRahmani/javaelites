{% extends 'base2.html.twig' %}

{% block title %}Ajouter une nouvelle question{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet"> <!-- FontAwesome -->
    <style>
        .invalid-feedback {
            display: block !important;
            color: #ff0000;
            font-weight: 500;
            margin-top: 5px;
            font-size: 14px;
        }
        .form-control.is-invalid {
            border-color: #ff0000;
        }
    </style>
    <link rel="stylesheet" href="{{ asset('assets/css/newquestion.css') }}">
{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Ajouter un nouvel énoncé de question</h1>

        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
        
        <div class="form-group mb-3">
            {{ form_label(form.text, 'Énoncé de la question *') }}
            {{ form_widget(form.text, {
                'attr': {
                    'class': 'form-control' ~ (form_errors(form.text) ? ' is-invalid' : ''),
                    'placeholder': 'Saisissez l\'énoncé de votre question (minimum 5 caractères)'
                }
            }) }}
            <div class="invalid-feedback">
                {{ form_errors(form.text) }}
            </div>
        </div>

        <div class="form-group mb-3">
            {{ form_label(form.point, 'Points *') }}
            {{ form_widget(form.point, {
                'attr': {
                    'class': 'form-control' ~ (form_errors(form.point) ? ' is-invalid' : ''),
                    'placeholder': 'Nombre de points (entre 0.5 et 20)'
                }
            }) }}
            <div class="invalid-feedback">
                {{ form_errors(form.point) }}
            </div>
        </div>

        <div class="form-group mb-3">
            {{ form_label(form.ordreQuestion, 'Ordre *') }}
            {{ form_widget(form.ordreQuestion, {
                'attr': {
                    'class': 'form-control' ~ (form_errors(form.ordreQuestion) ? ' is-invalid' : ''),
                    'placeholder': 'Ordre de la question (entre 1 et 100)'
                }
            }) }}
            <div class="invalid-feedback">
                {{ form_errors(form.ordreQuestion) }}
            </div>
        </div>

        <p class="text-muted"><small>* Champs obligatoires</small></p>

        <button type="submit" class="btn btn-success">
            <i class="fas fa-save"></i> Créer
        </button>

        {{ form_end(form) }}
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
