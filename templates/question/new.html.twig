{% extends 'base.html.twig' %}

{% block title %}Nouvelle Question{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet"> <!-- FontAwesome -->
    <link rel="stylesheet" href="{{ asset('assets/css/newquestion.css') }}">
{% endblock %}

{% block body %}
    <div class="form-container">
        <h2>Ajouter un nouvel énoncé de question</h2>

        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
        
            <div class="mb-3">
                {{ form_label(form.text, 'Énoncé de la question', {'class': 'form-label'}) }}
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="fas fa-edit"></i></span>
                    </div>
                    {{ form_widget(form.text, {'attr': {'class': 'form-control'}}) }}
                </div>
                {{ form_errors(form.text) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.point, 'Points', {'class': 'form-label'}) }}
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="fas fa-star"></i></span>
                    </div>
                    {{ form_widget(form.point, {'attr': {'class': 'form-control'}}) }}
                </div>
                {{ form_errors(form.point) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.ordreQuestion, 'Ordre', {'class': 'form-label'}) }}
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="fas fa-sort-numeric-up"></i></span>
                    </div>
                    {{ form_widget(form.ordreQuestion, {'attr': {'class': 'form-control'}}) }}
                </div>
                {{ form_errors(form.ordreQuestion) }}
            </div>

            <button type="submit" class="btn btn-success">
                <i class="fas fa-check-circle icon-btn"></i>Créer
            </button>

            <a href="#" class="btn btn-secondary">
                <i class="fas fa-times-circle icon-btn"></i>Annuler
            </a>
            
        {{ form_end(form) }}
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
