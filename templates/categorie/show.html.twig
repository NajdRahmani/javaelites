{% extends 'base2.html.twig' %}

{% block title %}Categorie{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Détails de la Catégorie</h3>

                  
                </div>
                <!-- /.card-header -->
                <div class="card-body table-responsive p-0">
                    <table class="table table-hover text-nowrap">
                        <tbody>
                            <tr>
                                <th>ID</th>
                                <td>{{ categorie.id }}</td>
                            </tr>
                            <tr>
                                <th>Name</th>
                                <td>{{ categorie.name }}</td>
                            </tr>
                            <tr>
                                <th>Description</th>
                                <td>{{ categorie.descrption }}</td>
                            </tr>
                            <tr>
                                <th>Icone</th>
                                <td>{{ categorie.icone }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <!-- /.card-body -->
            </div>
            <!-- /.card -->
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <a href="{{ path('app_categorie_index') }}" class="btn btn-default">Back to list</a>
            <a href="{{ path('app_categorie_edit', {'id': categorie.id}) }}" class="btn btn-primary">Edit</a>
            {{ include('categorie/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}