{% extends 'base.html.twig' %}

{% block title %}Cours - {{ cour.title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% if app.session.get('roles') is null or app.session.get('deleted') == 1 %}
        <script>
            window.location.href = "{{ app.session.get('deleted') == 1 ? path('logout') : path('app_login') }}";
        </script>
    {% endif %}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('assets/css/chapitre1.css') }}">
{% endblock %}

{% block body %}
<div class="container py-5">
    <a href="{{ path('app_cours_index2') }}" class="btn btn-outline-secondary mb-4">
        <i class="fas fa-arrow-left me-2"></i>Retour à la liste
    </a>

    <!-- Section Cours -->
    <div class="card shadow-lg mb-5">
        <div class="row g-0">
            <!-- Image -->
            <div class="col-md-6">
                <img src="{{ asset('uploads/brochures/' ~ cour.urlImage) }}" 
                     class="img-fluid rounded-start object-fit-cover"
                     alt="{{ cour.title }}">
            </div>
            
            <!-- Contenu -->
            <div class="col-md-6">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div>
                            <h1 class="card-title display-6 mb-2">{{ cour.title }}</h1><br>
                            <h1 class="card-title display-6 mb-2"><large>Langue :</large>{{ cour.langue }}</h1>
                        </div>
                        <span class="text-muted">Enseignant :{{ cour.enseignant.nom }} {{ cour.enseignant.prenom }}</span>
                    </div>

                    <p class="card-text lead mb-4">{{ cour.matiere.categorie.name }}</p>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h5 class="mb-0">
                                <i class="fas fa-book-open me-2"></i>{{ cour.nbChapitres }} Chapitres
                            </h5>
                        </div>
                       
                            <div class="bg-light p-3 rounded">
    <h2 class="text-primary mb-0">
        {% if cour.prix == 0 %}
            Gratuit
        {% else %}
            {{ cour.prix }} DT
        {% endif %}
    </h2>

                        </div>
                    </div>

                  {% if cour.isUserEnrolled(app.session.get('id')) %}
    <div class="alert alert-success w-100 text-center py-3">
        <i class="fas fa-check-circle me-2"></i>Vous êtes déjà inscrit à ce cours
    </div>
{% else %}
    <button 
        class="btn btn-primary btn-lg w-100 py-3"
        onclick="showVerification()">
        <i class="fas fa-user-plus me-2"></i>S'inscrire maintenant
    </button>
{% endif %}

                </div>
            </div>
        </div>
    </div>

    <!-- Description -->
    <div class="card shadow-lg mb-5">
        <div class="card-header bg-light">
            <h3 class="card-title mb-0">
                <i class="fas fa-info-circle me-2"></i>Description détaillée
            </h3>
        </div>
        <div class="card-body p-4">
            <p class="mb-0 text-muted">{{ cour.description }}</p>
        </div>
    </div>

    <!-- Liste des chapitres -->
    <h2 class="mb-4">
        <i class="fas fa-list-ol me-2"></i>Liste des chapitres
    </h2>
    
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        {% for chapitre in cour.chapitres %}
            <div class="col">
                <div class="card h-100 shadow-sm chapter-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge bg-secondary">Chapitre </span>
                            <small class="text-muted">ordre: {{ chapitre.chapOrder }}</small>
                        </div>
                        <h5 class="card-title mb-3">{{ chapitre.title }}</h5>
                        <div class="d-flex justify-content-end">
                            <a href="{{ path('app_etudiant', {'id': chapitre.id}) }}" 
                               class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-eye me-2"></i>Voir
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-info text-center py-4">
                    <i class="fas fa-exclamation-circle fa-2x mb-3"></i>
                    <h4 class="alert-heading">Aucun chapitre disponible</h4>
                    <p class="mb-0">Ce cours ne contient pas encore de chapitres</p>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
<div id="verificationModal" class="verification-overlay" style="display: none;">
    <div class="verification-content">
        <h4>Confirmation requise</h4>
        <p>Êtes-vous sûr de vouloir continuer ?</p>

        <div class="d-flex gap-2 justify-content-end mt-4">
            <button class="btn btn-secondary" onclick="hideVerification()">Annuler</button>
            <a href="{{ path('route2',{'id': cour.id}) }}" class="btn btn-primary">Confirmer</a>
        </div>
    </div>
</div>
<script>
function showVerification() {
    document.getElementById('verificationModal').style.display = 'flex';
}

function hideVerification() {
    document.getElementById('verificationModal').style.display = 'none';
}
</script>
<style>
.verification-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1000;
}

.verification-content {
    background: white;
    padding: 2rem;
    border-radius: 10px;
    min-width: 400px;
    box-shadow: 0 0 20px rgba(0,0,0,0.2);
    animation: fadeIn 0.3s ease-out;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(-20px); }
    to { opacity: 1; transform: translateY(0); }
}
    .object-fit-cover {
        object-fit: cover;
            height: 342px;
    width: 568px;
    }
    .btn-outline-secondary{
      color:black;
  background-color:rgb(173, 186, 224);
    }
.btn-outline-primary{
  color:black;
  background-color:rgb(51, 104, 252);
}
    .chapter-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .chapter-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,.15);
    }

    .card-header {
        background: linear-gradient(120deg, #f8f9fa 0%, #e9ecef 100%);
    }

    .btn-outline-primary {
        border-width: 2px;
    }

    .lead {
        font-size: 1.1rem;
        line-height: 1.7;
        color: #495057;
    }
</style>
{% endblock %}