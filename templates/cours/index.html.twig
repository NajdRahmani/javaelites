{% extends 'base.html.twig' %}

{% block title %}Catalogue des Cours{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% if app.session.get('roles') is null or app.session.get('deleted') == 1 %}
        <script>
            window.location.href = "{{ app.session.get('deleted') == 1 ? path('logout') : path('app_login') }}";
        </script>
    {% endif %}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('assets/css/chapitre1.css') }}">
{% endblock %}

{% block body %}

<div class="container py-5">
    <h1 class="display-4 mb-4 text-center fw-bold">Explorez Nos Cours</h1>

    <!-- Filtres et recherche -->
    <!-- Filtres et recherche améliorés -->
<div class="card shadow-lg mb-5 border-0 bg-light">
    <div class="card-body p-4">
        <form action="{{ path('app_cours_index2') }}" method="get" class="row g-3 align-items-center">
            <div class="col-md-5 position-relative">
                <input type="text" 
                       name="search" 
                       class="form-control ps-5" 
                       placeholder="Rechercher un cours..."
                       value="{{ app.request.query.get('search') }}">
            </div>

            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="fas fa-filter text-muted"></i></span>
                    <select name="matiere" class="form-select form-select-lg shadow-sm border-start-0">
                        <option value="">Toutes les matières</option>
                        {% for matiere in matieres %}
                            <option value="{{ matiere.id }}" {{ app.request.query.get('matiere') == matiere.id ? 'selected' : '' }}>
                                {{ matiere.titre }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-lg w-100 shadow-lg hover-scale">
                    <i class="fas fa-sliders-h me-2"></i>Appliquer
                </button>
                <a href="{{ path('app_cours_index2') }}" class="btn btn-light btn-lg border hover-scale" title="Réinitialiser">
                    <i class="fas fa-undo text-secondary"></i>
                </a>
            </div>
        </form>
    </div>
</div>

    <!-- En-têtes de tri -->
   <div class="d-flex justify-content-end mb-4">
    <div class="btn-group shadow-sm rounded-pill overflow-hidden">
        {% set current_sort = current_sort|default({'field': 'c.title', 'direction': 'asc'}) %}
        
        <a href="{{ path('app_cours_index2', app.request.query.all|merge({
            'sort_by': 'c.title', 
            'sort_order': (current_sort.field == 'c.title' and current_sort.direction == 'asc') ? 'desc' : 'asc'
        })) }}" 
           class="btn btn-sort {{ current_sort.field == 'c.title' ? 'active' : '' }}">
            <i class="fas fa-font me-2"></i>Titre
            <i class="fas fa-sort-{{ current_sort.field == 'c.title' ? current_sort.direction|lower : 'asc' }} ms-2"></i>
        </a>
        
        <a href="{{ path('app_cours_index2', app.request.query.all|merge({
            'sort_by': 'nbChapitres', 
            'sort_order': (current_sort.field == 'nbChapitres' and current_sort.direction == 'asc') ? 'desc' : 'asc'
        })) }}" 
           class="btn btn-sort {{ current_sort.field == 'nbChapitres' ? 'active' : '' }}">
            <i class="fas fa-list-ol me-2"></i>Chapitres
            <i class="fas fa-sort-{{ current_sort.field == 'nbChapitres' ? current_sort.direction|lower : 'asc' }} ms-2"></i>
        </a>
        
        <a href="{{ path('app_cours_index2', app.request.query.all|merge({
            'sort_by': 'NbEtudiants', 
            'sort_order': (current_sort.field == 'NbEtudiants' and current_sort.direction == 'asc') ? 'desc' : 'asc'
        })) }}" 
           class="btn btn-sort {{ current_sort.field == 'NbEtudiants' ? 'active' : '' }}">
            <i class="fas fa-users me-2"></i>Étudiants
            <i class="fas fa-sort-{{ current_sort.field == 'NbEtudiants' ? current_sort.direction|lower : 'asc' }} ms-2"></i>
        </a>
    </div>
</div>

    <!-- Grille de cours -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        {% for cour in pagination %}
            <div class="col course-card">
                <div class="card h-100 shadow-lg border-0 overflow-hidden transform-on-hover">
                    <div class="card-header position-relative p-0 overflow-hidden" style="height: 180px;">
                        <img src="{{ asset('uploads/brochures/' ~ cour.urlImage) }}" 
                             class="card-img-top h-100 object-fit-cover" 
                             alt="{{ cour.title }}">
                        <div class="image-overlay">
                            <span class="badge bg-primary position-absolute top-0 end-0 m-3 shadow-sm">
                                {{ cour.enseignant.nom }} {{ cour.enseignant.prenom }}
                            </span>
                        </div>
                    </div>
                    
                    <div class="card-body position-relative pt-4">
                        <div class="course-avatar position-absolute top-0 start-50 translate-middle" style="top: -21px;">
                           <img src="{{ asset('uploads/user/' ~ cour.enseignant.image) }}"  
                                 class="rounded-circle shadow-lg border border-3 border-white" 
                                 width="80" 
                                 height="80" 
                                 alt="Formateur">
                        </div>
                        <h3 class="h5 fw-bold mb-3 text-center">{{ cour.title }}</h3>
                        
                        <div class="d-flex justify-content-center gap-3 mb-3">
                            <div class="text-center">
                                <div class="h4 mb-0 text-primary">{{ cour.nbChapitres }}</div>
                                <small class="text-muted">Chapitres</small>
                            </div>
                            <div class="vr"></div>
                            <div class="text-center">
                                <div class="h4 mb-0 text-primary">{{ cour.NbEtudiants }}</div>
                                <small class="text-muted">Apprenants</small>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-transparent border-0 pt-0 pb-4">
                        <a href="{{ path('app_cours_show', {'id': cour.id}) }}" 
                           class="btn btn-outline-primary w-100 btn-hover">
                            <i class="fas fa-book-open me-2"></i>Voir le cours
                        </a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-info shadow-lg text-center py-4">
                    <i class="fas fa-book-open fa-3x text-muted mb-3"></i>
                    <h4 class="alert-heading">Aucun cours disponible</h4>
                    <p class="mb-0">Commencez par créer un nouveau cours !</p>
                </div>
            </div>
        {% endfor %}
    </div>

    <!-- Pagination -->
    <div class="mt-5 d-flex justify-content-center">
    {{ knp_pagination_render(pagination, '@KnpPaginator/Pagination/twitter_bootstrap_v4_pagination.html.twig', {
        'align': 'center',
        'size': 'large',
        'rounded': true,
    }) }}
</div>
</div>

