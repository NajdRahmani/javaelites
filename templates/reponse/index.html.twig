{% extends 'base2.html.twig' %}

{% block title %}Liste des Réponses{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .reponse-text {
            max-width: 400px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-4">Liste des Réponses</h1>

        <div class="text-end mb-3">
            <a href="{{ path('app_reponse_new') }}" class="btn btn-success">
                <i class="fas fa-plus"></i> Nouvelle Réponse
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Texte</th>
                        <th>Est Correcte</th>
                        <th>Question</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for reponse in reponses %}
                    <tr>
                        <td class="reponse-text" title="{{ reponse.text }}">{{ reponse.text }}</td>
                        <td>
                            {% if reponse.isCorrect %}
                                <span class="badge bg-success">Oui</span>
                            {% else %}
                                <span class="badge bg-danger">Non</span>
                            {% endif %}
                        </td>
                        <td>{{ reponse.question.text }}</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a href="{{ path('app_reponse_show', {'id': reponse.id}) }}" class="btn btn-primary btn-sm">
                                    <i class="fas fa-eye"></i> Voir
                                </a>
                                <a href="{{ path('app_reponse_edit', {'id': reponse.id}) }}" class="btn btn-warning btn-sm">
                                    <i class="fas fa-edit"></i> Modifier
                                </a>
                                <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal{{ reponse.id }}">
                                    <i class="fas fa-trash"></i> Supprimer
                                </button>
                            </div>

                            {% include 'partials/_delete_confirmation_modal.html.twig' with {
                                'id': reponse.id,
                                'path': path('app_reponse_delete', {'id': reponse.id}),
                                'csrf_token': csrf_token('delete' ~ reponse.id)
                            } %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center">Aucune réponse trouvée</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
