{% extends 'base.html.twig' %}

{% block title %}Créer une Nouvelle Réponse{% endblock %}

{% block stylesheets %}
    <!-- Bootstrap & FontAwesome -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('assets/css/newreponse.css') }}">
{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="card shadow-lg p-4">
            <!-- Titre -->
            <h2 class="card-title text-center mb-3">Créer une Nouvelle Réponse</h2>
            <p class="card-text text-center text-muted">
                Nous sommes ravis de vous voir ajouter une nouvelle réponse. Chaque contribution est importante !
            </p>

            <!-- Formulaire -->
            <div class="mt-4">
                {{ form_start(form) }}
                <div class="mb-3">
                        {{ question}}
                    </div>
                    <div class="mb-3">
                        {{ form_row(form.text) }}
                    </div>
                    
                {{ form_end(form) }}
            </div>

            <!-- Bouton Retour -->
            <div class="text-center mt-4">
                <a href="{{ path('app_reponse_index') }}" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Retour à la liste
                </a>
            </div>

            <!-- Texte Motivationnel -->
            <p class="text-center text-muted mt-3">
                Continuez à apprendre et à répondre ! Vos efforts contribuent à une meilleure éducation pour tous.
            </p>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
