{% extends 'base.html.twig' %}

{% block title %}Détails de la Réponse{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet"> <!-- FontAwesome -->
       <link rel="stylesheet" href="{{ asset('assets/css/showreponse.css') }}">

{% endblock %}

{% block body %}
    <div class="container1">
        <h2 class="text-center mb-4">Détails de la Réponse</h2>

        <div class="card">
            <div class="card-body">
                <h5 class="card-title"><i class="fas fa-info-circle icon-btn"></i>Détails de la Réponse #{{ reponse.id }}</h5>
                <p class="card-text"><strong><i class="fas fa-file-alt"></i> Text :</strong> {{ reponse.text }}</p>
                <p class="card-text"><strong><i class="fas fa-check-circle"></i> Correcte :</strong> {{ reponse.isCorrect ? 'Oui' : 'Non' }}</p>
                <p class="card-text"><strong><i class="fas fa-user-graduate"></i> Id Étudiant :</strong> {{ reponse.UserId }}</p>
            </div>

            <div class="card-footer">
                <a href="{{ path('app_reponse_index') }}" class="btn btn-secondary btn-lg">
                    <i class="fas fa-arrow-left icon-btn"></i>Retour à la liste
                </a>
                
                {{ include('reponse/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
