{% extends 'base.html.twig' %}

{% block title %}QuizResponse index{% endblock %}

{% block body %}
    <h1>QuizResponse index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Texte</th>
                <th>EstCorrecte</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for quiz_response in quiz_responses %}
            <tr>
                <td>{{ quiz_response.id }}</td>
                <td>{{ quiz_response.texte }}</td>
                <td>{{ quiz_response.estCorrecte ? 'Yes' : 'No' }}</td>
                <td>
                    <a href="{{ path('app_quiz_response_show', {'id': quiz_response.id}) }}">show</a>
                    <a href="{{ path('app_quiz_response_edit', {'id': quiz_response.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_quiz_response_new') }}">Create new</a>
{% endblock %}
