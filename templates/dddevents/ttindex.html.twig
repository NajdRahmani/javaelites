{% extends 'base.html.twig' %}

{% block title %}Events | EduWell{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/css/events.css') }}">
{% endblock %}

{% block body %}
<div class="main-banner">
<section class="light">
	<div class="container py-2">
		<div class="h1 text-center text-dark" id="pageHeaderTitle">Our Events</div>
		<article class="postcard light blue">
			<a class="postcard__img_link" href="{{ path('events_show', {'id': 1}) }}">
				<img class="postcard__img" src="{{ asset('assets/images/event-1.jpg') }}" alt="Image Title" />
			</a>
			<div class="postcard__text t-dark">
				<h1 class="postcard__title blue"><a href="{{ path('events_show', {'id': 1}) }}">Graphic Design Bootcamp</a></h1>
				<div class="postcard__subtitle small">
					<time datetime="2020-05-25 12:00:00">
						<i class="fas fa-calendar-alt mr-2"></i>Mon, May 25th 2020
					</time>
				</div>
				<div class="postcard__bar"></div>
				<div class="postcard__preview-txt">Lorem ipsum dolor sit amet consectetur adipisicing elit. Eligendi, fugiat asperiores inventore beatae accusamus odit minima enim, commodi quia, doloribus eius! Ducimus nemo accusantium maiores velit corrupti tempora reiciendis molestiae repellat vero. Eveniet ipsam adipisci illo iusto quibusdam, sunt neque nulla unde ipsum dolores nobis enim quidem excepturi, illum quos!</div>
				<ul class="postcard__tagbox">
					<li class="tag__item">Online</li>
					<li class="tag__item"></i>Design</li>
					<li class="tag__item play blue">
						<a href="{{ path('events_show', {'id': 1}) }}">Free</a>
					</li>
				</ul>
			</div>
		</article>
	</div>
{% endblock %}
