
{% extends 'base.html.twig' %}

{% block title %}{{ event.title }} | EduWell{% endblock %}

{% block body %}
<div class="main-banner">
<div class="container mt-5">
    <div class="card shadow-lg p-4">
        <h1 class="text-center text-primary">{{ event.title }}</h1>
        <p class="text-muted text-center">{{ event.type }}</p>
        <img src="{{ asset('assets/images/event-1.jpg') }}" class="card-img-top" alt="Event Image">
        
        <div class="mt-3">
            <p><strong>Description:</strong> {{ event.description }}</p>
            <p><strong>Start Date:</strong> <span class="badge bg-success">{{ event.start_date }}</span></p>
            <p><strong>End Date:</strong> <span class="badge bg-danger">{{ event.end_date }}</span></p>
            <p><strong>Max Participants:</strong> {{ event.max_participants }}</p>
        </div>

        <div class="text-center mt-4">
            <a href="#" class="btn btn-lg btn-primary">Reserve Now</a>
        </div>
    </div>
</div>
</div>
{% endblock %}
