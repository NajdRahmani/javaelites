{% extends 'base.html.twig' %}

{% block title %}Chapitre - {{ chapitre.title }}{% endblock %}

{% block body %}
{% if app.session.get('roles') is null %}
    <script type="text/javascript">
        window.location.href = "{{ path('app_login') }}";
    </script>
{% endif %}
{% if app.session.get('deleted') == 1 %}
    <script type="text/javascript">
        window.location.href = "{{ path('logout') }}";
    </script>
{% endif %}

<div class="container py-5">
    <div class="card shadow-lg">
        <div class="card-header bg-light text-white d-flex justify-content-between align-items-center py-3">
            <h2 class="h4 mb-0">{{ chapitre.title }}</h2>
            <span class="badge bg-primary text-primary fs-6">Chapitre #{{ chapitre.chapOrder }}</span>
        </div>

        <div class="card-body">
            <dl class="mb-0">
                <!-- Ajout de marges et d'espacement vertical -->
                <div class="row mb-3">
                    <dt class="col-sm-3 text-muted mb-2 mb-sm-0">Titre</dt>
                    <dd class="col-sm-9 fs-5">{{ chapitre.title }}</dd>
                </div>

                <div class="row mb-3">
                    <dt class="col-sm-3 text-muted mb-2 mb-sm-0">Ordre du chapitre</dt>
                    <dd class="col-sm-9">{{ chapitre.chapOrder }}</dd>
                </div>

                <div class="row mb-3">
                    <dt class="col-sm-3 text-muted mb-2 mb-sm-0">Contenu</dt>
                    <dd class="col-sm-9">
                        <a href="{{ asset('uploads/brochures/' ~ chapitre.contenu) }}" 
                           class="btn btn-outline-primary d-inline-flex align-items-center"
                           target="_blank">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-pdf me-2" viewBox="0 0 16 16">
                                <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5h-2z"/>
                                <path d="M4.603 14.087a.81.81 0 0 1-.438-.42c-.195-.388-.13-.776.08-1.102.198-.307.526-.568.897-.787a7.68 7.68 0 0 1 1.482-.645 19.697 19.697 0 0 0 1.062-2.227 7.269 7.269 0 0 1-.43-1.295c-.086-.4-.119-.796-.046-1.136.075-.354.274-.672.65-.823.192-.077.4-.12.602-.077.28.058.546.23.704.544.13.245.16.52.103.79-.127.535-.544.928-1.078 1.164-.642.283-1.389.44-2.213.443-.188 0-.375.006-.56.016a1.794 1.794 0 0 0 1.35 1.594c.337.092.682.163 1.037.21.44.056.88.095 1.324.105.41.008.805-.024 1.188-.078.286-.041.57-.103.85-.183.237-.068.47-.156.688-.257l-.738.591a1.84 1.84 0 0 0-.367.272c-.217.2-.403.427-.552.67-.05.083-.113.16-.183.232-.19.194-.445.301-.739.295a.922.922 0 0 1-.598-.222.952.952 0 0 1-.327-.622c-.034-.25.029-.518.172-.753.11-.18.266-.335.466-.447.356-.25.824-.382 1.387-.382.38 0 .74.057 1.088.169.466.15.85.427 1.16.835.221.3.367.655.432 1.059.06.367.082.756.067 1.16-.013.444-.05.883-.113 1.315-.01.062-.02.124-.03.185a7.148 7.148 0 0 1-.401 1.396c-.124.312-.272.613-.444.894a2.008 2.008 0 0 1-.75.664 2.044 2.044 0 0 1-.963.184 1.71 1.71 0 0 1-.697-.127 1.655 1.655 0 0 1-.548-.354 1.85 1.85 0 0 1-.384-.532q-.17-.33-.26-.714a3.1 3.1 0 0 1-.088-.669c-.005-.143.005-.285.03-.425z"/>
                            </svg>
                            Voir le document PDF
                        </a>
                    </dd>
                </div>
            </dl>
        </div>

        <div class="card-footer bg-light py-3">
            <a href="{{ path('app_cours_show', {'id': chapitre.cours.id}) }}" 
               class="btn btn-outline-secondary d-inline-flex align-items-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left me-2" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
                </svg>
                Retour au cours
            </a>
        </div>
    </div>
</div>
{% endblock %}