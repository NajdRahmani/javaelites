{% extends 'base3.html.twig' %}

{% block title %}Correction de la réponse{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h2>Correction - {{ evaluation.title }}</h2>
        </div>
        <div class="card-body">
            <div class="mb-4">
                <h4>Question</h4>
                <h5>{{ reponse.question.title }}</h5>
                <p class="bg-light p-3 rounded">{{ reponse.question.enonce }}</p>
                <p><strong>Points possibles :</strong> {{ reponse.question.point }}</p>
            </div>

            <div class="mb-4">
                <h4>Réponse de l'étudiant</h4>
                {% if reponse.plagiatSuspect %}
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-triangle"></i>
                        <strong>Attention :</strong> Cette réponse contient du contenu inapproprié
                        <p class="mb-0"><small>Détecté le : {{ reponse.submitTime|date('d/m/Y H:i:s') }}</small></p>
                        {% if reponse.plagiatDetails %}
                            <p class="mb-0"><small>Détails : {{ reponse.plagiatDetails }}</small></p>
                        {% endif %}
                    </div>
                {% endif %}
                <div class="bg-light p-3 rounded">
                    {{ reponse.text }}
                </div>
            </div>

            <form method="POST" action="{{ path('evaluation_save_correctionenseignant', {
                'evaluationId': evaluation.id,
                'studentId': reponse.user.id
            }) }}">
                <div class="mb-3">
                    <label for="note" class="form-label">Note</label>
                    <input type="number" class="form-control" id="note" name="note" 
                           min="0" max="{{ reponse.question.point }}" 
                           value="{{ reponse.note }}" required>
                </div>

                <div class="mb-3">
                    <label for="commentaire" class="form-label">Commentaire</label>
                    <textarea class="form-control" id="commentaire" name="commentaire" rows="3">{{ reponse.commentaire }}</textarea>
                </div>

                <div class="d-flex justify-content-between">
                    <a href="{{ path('app_evaluation_student_list', {'evaluationId': evaluation.id}) }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Retour à la liste
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Enregistrer la correction
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}