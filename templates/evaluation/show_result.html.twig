{% extends 'base.html.twig' %}

{% block title %}Résultat de l'évaluation{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Résultat de l'évaluation : {{ evaluation.title }}</h1>

        {% if evaluation.isCompleted %}
            <div class="alert {% if hasInappropriateContent %}alert-danger{% else %}alert-success{% endif %} mt-4">
                <h4 class="alert-heading">
                    {% if hasInappropriateContent %}
                        ⚠️ Attention : Contenu inapproprié détecté !
                    {% else %}
                        ✅ Évaluation corrigée
                    {% endif %}
                </h4>
                <p>Votre note finale : {{ totalScore }}/{{ maxScore }} ({{ (totalScore/maxScore * 100)|number_format(1) }}%)</p>
            </div>

            {% for reponse in reponses %}
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center {% if reponse.note == 0 and reponse.commentaire starts with 'AVERTISSEMENT' %}bg-danger text-white{% endif %}">
                        <h5>Question {{ reponse.question.ordreQuestion }}</h5>
                        <span class="badge {% if reponse.note == 0 %}bg-danger{% else %}bg-success{% endif %} bg-opacity-75">
                            {{ reponse.note }}/{{ reponse.question.point }}
                        </span>
                    </div>
                    <div class="card-body">
                        <h6>Votre réponse :</h6>
                        <div class="p-3 bg-light {% if reponse.note == 0 and reponse.commentaire starts with 'AVERTISSEMENT' %}border border-danger{% endif %}">
                            {{ reponse.text }}
                        </div>

                        {% if reponse.commentaire starts with 'AVERTISSEMENT' %}
                            <div class="alert alert-danger mt-3">
                                <h6 class="alert-heading">⚠️ Avertissement - Contenu inapproprié</h6>
                                <p>{{ reponse.commentaire[13:] }}</p>
                                <hr>
                                <p class="mb-0"><strong>Conséquence :</strong> Note attribuée : 0/{{ reponse.question.point }}</p>
                            </div>
                        {% else %}
                            {% if reponse.commentaire %}
                                <div class="alert alert-info mt-3">
                                    <h6>Commentaire de l'enseignant :</h6>
                                    <p>{{ reponse.commentaire }}</p>
                                </div>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
            {% endfor %}

            {% if hasInappropriateContent %}
                <div class="alert alert-warning mt-4">
                    <h5>⚠️ Important - Sanctions pour contenu inapproprié</h5>
                    <p>Une ou plusieurs de vos réponses ont été identifiées comme contenant du contenu inapproprié. 
                    Ces réponses ont automatiquement reçu une note de 0 et cet incident peut entraîner des sanctions disciplinaires supplémentaires.</p>
                    <p class="mb-0">Veuillez prendre connaissance des avertissements ci-dessus et vous assurer de respecter le code de conduite dans vos futures réponses.</p>
                </div>
            {% endif %}
        {% else %}
            <div class="alert alert-info">
                <h4 class="alert-heading">En attente de correction</h4>
                <p>Votre évaluation n'a pas encore été corrigée. Veuillez patienter.</p>
            </div>
        {% endif %}

        <div class="mt-4">
            <a href="{{ path('app_evaluation_list') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
        </div>
    </div>
{% endblock %}
