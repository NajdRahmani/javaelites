{% extends 'base.html.twig' %}

{% block title %}Détail de mes réponses - {{ evaluation.title }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">{{ evaluation.title }}</h2>
        </div>
        <div class="card-body">
            <div class="mb-4">
                <p class="text-muted">{{ evaluation.description }}</p>
                <div class="d-flex gap-2">
                    <span class="badge bg-primary">Score Maximum: {{ evaluation.maxScore }}</span>
                    <span class="badge {% if evaluation.deadline < date() %}bg-danger{% else %}bg-info{% endif %}">
                        Date limite: {{ evaluation.deadline|date('d/m/Y H:i') }}
                    </span>
                </div>
            </div>

            <div class="accordion" id="questionsAccordion">
                {% for question in questions %}
                    <div class="accordion-item">
                        <h3 class="accordion-header" id="heading{{ question.id }}">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" 
                                    data-bs-target="#collapse{{ question.id }}" aria-expanded="false">
                                Question {{ loop.index }} ({{ question.point }} points)
                            </button>
                        </h3>
                        <div id="collapse{{ question.id }}" class="accordion-collapse collapse" 
                             data-bs-parent="#questionsAccordion">
                            <div class="accordion-body">
                                <p><strong>Question :</strong> {{ question.text }}</p>
                                
                                {% set userReponse = null %}
                                {% for reponse in question.reponses %}
                                    {% if reponse.userId == userId %}
                                        {% set userReponse = reponse %}
                                    {% endif %}
                                {% endfor %}

                                {% if userReponse %}
                                    <div class="mt-3">
                                        <p><strong>Votre réponse :</strong></p>
                                        <div class="border p-3 rounded bg-light">
                                            {{ userReponse.text }}
                                        </div>
                                        {% if userReponse.note is not null %}
                                            <div class="mt-2">
                                                <span class="badge bg-primary">Note : {{ userReponse.note }}/{{ question.point }} points</span>
                                            </div>
                                        {% else %}
                                            <div class="mt-2">
                                                <span class="badge bg-warning">En attente de correction</span>
                                            </div>
                                        {% endif %}
                                    </div>
                                {% else %}
                                    <div class="alert alert-warning">
                                        Vous n'avez pas répondu à cette question.
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a href="{{ path('app_evaluation_mes_reponses_list') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Retour à la liste
        </a>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
