{% extends 'base3.html.twig' %}

{% block title %}Liste des étudiants à corriger{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="evaluation-header bg-primary text-white p-3 mb-4">
        <h2>{{ evaluation.title }}</h2>
        <p class="mb-0">{{ evaluation.description }}</p>
        <p class="mb-0">Score maximum total : {{ evaluation.maxScore }} points</p>
    </div>

    <h3>Liste des étudiants à corriger</h3>

    {% if userResponses|length > 0 %}
        <div class="student-list">
            {% for userId, userData in userResponses %}
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0">Étudiant ID: {{ userId }}</h5>
                            {% if userData.isCorrected %}
                                <span class="badge bg-success">Corrigé</span>
                            {% else %}
                                <span class="badge bg-warning">En attente de correction</span>
                            {% endif %}
                        </div>
                        <div class="mt-3">
                            <a href="{{ path('evaluation_correctenseignant_student', {'evaluationId': evaluation.id, 'studentId': userId}) }}" 
                               class="btn btn-primary">
                                {% if userData.isCorrected %}
                                    <i class="fas fa-edit"></i> Modifier la correction
                                {% else %}
                                    <i class="fas fa-check"></i> Corriger les réponses
                                {% endif %}
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="alert alert-info">
            Aucun étudiant n'a encore répondu à cette évaluation.
        </div>
    {% endif %}

    <a href="{{ path('app_evaluation_indexenseignant') }}" class="btn btn-secondary mt-3">
        <i class="fas fa-arrow-left"></i> Retour à la liste des évaluations
    </a>
</div>

<style>
    .evaluation-header {
        border-radius: 5px;
    }
    .student-list {
        max-width: 800px;
        margin: 0 auto;
    }
    .card {
        transition: all 0.3s ease;
    }
    .card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
    .badge {
        font-size: 0.9rem;
        padding: 8px 12px;
    }
</style>
{% endblock %}
