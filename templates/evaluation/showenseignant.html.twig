{% extends 'base2.html.twig' %}

{% block title %}Evaluation{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="{{ asset('assets/css/showevaluation.css') }}">
{% endblock %}

{% block body %}
    <div class="form-container">
        <h1>Evaluation</h1>

        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ evaluation.id }}</td>
                </tr>
                <tr>
                    <th>Title</th>
                    <td>{{ evaluation.title }}</td>
                </tr>
                <tr>
                    <th>Description</th>
                    <td>{{ evaluation.description }}</td>
                </tr>
                <tr>
                    <th>Max Score</th>
                    <td>{{ evaluation.maxScore }}</td>
                </tr>
                <tr>
                    <th>Create At</th>
                    <td>{{ evaluation.createAt ? evaluation.createAt|date('Y-m-d H:i:s') : '' }}</td>
                </tr>
                <tr>
                    <th>Deadline</th>
                    <td>{{ evaluation.deadline ? evaluation.deadline|date('Y-m-d H:i:s') : '' }}</td>
                </tr>
                <tr>
                    <th>Number of Courses</th>
                    <td>{{ evaluation.cours }}</td>
                </tr>
            </tbody>
        </table>

        <h3>Questions for this Evaluation</h3>
        <ul class="list-group">
            {% for question in questions %}
                <li class="list-group-item">
                    <strong>Question {{ question.ordreQuestion }}:</strong> {{ question.text }}

                    <a href="{{ path('app_question_show', {'id': question.id}) }}" class="btn btn-primary btn-sm">👀 Voir</a>
                    <a href="{{ path('app_question_edit', {'id': question.id}) }}" class="btn btn-warning btn-sm">✏️ Modifier</a>
                    {{ include('question/_delete_form.html.twig') }}

                    <h5 class="mt-3">Réponses des étudiants :</h5>
                    {% if responsesByQuestion[question.id] is not empty %}
                        <ul class="list-group">
                            {% for reponse in responsesByQuestion[question.id] %}
                                <li class="list-group-item">
                                    <strong>Étudiant :</strong> {{ reponse.etudiant.nom }} <br>
                                    <strong>Réponse :</strong> {{ reponse.texte }}
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p>Aucune réponse pour cette question.</p>
                    {% endif %}
                </li>
            {% else %}
                <li class="list-group-item">No questions available for this evaluation.</li>
            {% endfor %}
        </ul>

        <div class="form-group text-center mt-3">
            <a href="{{ path('app_evaluation_indexenseignant') }}" class="btn btn-secondary">Back to List</a>
            <a href="{{ path('app_evaluation_edit', {'id': evaluation.id}) }}" class="btn btn-warning">Edit</a>
        </div>

<!-- Bouton de suppression -->
<button class="btn btn-danger" onclick="showDeleteConfirmation({{ evaluation.id }})">Delete</button>

<!-- Modal de confirmation -->
<div id="delete-modal-{{ evaluation.id }}" class="delete-modal" style="display: none;">
    <div class="modal-content">
        <p>Are you sure you want to delete this evaluation?</p>
        <form id="delete-form-{{ evaluation.id }}" method="post" action="{{ path('app_evaluation_delete', {'id': evaluation.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evaluation.id) }}">
            <button type="submit" class="btn btn-danger">Yes, delete</button>
            <button type="button" class="btn btn-secondary" onclick="hideDeleteConfirmation({{ evaluation.id }})">Cancel</button>
        </form>
    </div>
</div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
