{% extends 'base3.html.twig' %}

{% block title %}Liste des Évaluations{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .evaluation-list {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 2rem;
        }
        .table th {
            background-color: #f8f9fa;
        }
        .evaluation-title {
            max-width: 200px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .deadline-warning {
            color: #dc3545;
            font-weight: bold;
        }
        .deadline-passed {
            color: #6c757d;
        }
        .status-badge {
            padding: 0.5em 1em;
            border-radius: 4px;
            font-size: 0.875em;
        }
        .status-completed {
            background-color: #28a745;
            color: white;
        }
        .status-pending {
            background-color: #ffc107;
            color: #000;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="evaluation-list">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Mes Évaluations</h1>
        </div>

        <div class="card">
            <div class="card-body">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Titre</th>
                            <th>Description</th>
                            <th>Score Maximum</th>
                            <th>Date Limite</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for item in evaluations %}
                        <tr>
                            <td class="evaluation-title">{{ item.title }}</td>
                            <td>{{ item.description|length > 50 ? item.description|slice(0, 50) ~ '...' : item.description }}</td>
                            <td>{{ item.maxScore }}</td>
                            <td>
                                {% if item.deadline < date() %}
                                    <span class="deadline-passed">{{ itemdeadline|date('d/m/Y H:i') }}</span>
                                {% elseif date().modify('+24 hours') > item.deadline %}
                                    <span class="deadline-warning">{{ item.deadline|date('d/m/Y H:i') }}</span>
                                {% else %}
                                    {{ item.deadline|date('d/m/Y H:i') }}
                                {% endif %}
                            </td>
                            <td>
                                {% if item.hasResponded %}
                                    <span class="status-badge status-completed">Complété</span>
                                {% else %}
                                    <span class="status-badge status-pending">En attente</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if not item.hasResponded and item.deadline > date() %}
                                    <a href="{{ path('etudiant_evaluation_show', {'id': item.id}) }}" 
                                       class="btn btn-primary btn-sm">
                                        <i class="fas fa-pen"></i> Répondre
                                    </a>
                                {% elseif item.hasResponded %}
                                    <a href="{{ path('app_evaluation_show_result', {'id': item.id}) }}" 
                                       class="btn btn-info btn-sm">
                                        <i class="fas fa-eye"></i> Voir les résultats
                                    </a>
                                {% else %}
                                    <span class="text-muted">Délai expiré</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center">Aucune évaluation disponible</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {% if app.session.flashBag.has('success') %}
        <div class="alert alert-success">
            {{ app.session.flashBag.get('success')[0] }}
        </div>
    {% endif %}
{% endblock %}
