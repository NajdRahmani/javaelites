{% extends 'base.html.twig' %}

{% block title %}Evaluation{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="{{ asset('assets/css/showevaluation.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.24.1/themes/prism.min.css">
    <style>
        .code-block {
            background: #f8f9fa;
            border-radius: 4px;
            padding: 1rem;
            margin: 1rem 0;
            border: 1px solid #dee2e6;
        }
        pre {
            margin: 0;
            padding: 1rem;
            background: #2d2d2d;
            color: #fff;
            border-radius: 4px;
            overflow-x: auto;
        }
        code {
            font-family: 'Source Code Pro', monospace;
            font-size: 14px;
            line-height: 1.5;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="form-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Evaluation</h1>
            <a href="{{ path('app_evaluation_indexetudiant') }}" class="btn btn-secondary">Retour à la liste</a>
        </div>

        <table class="table">
            <tbody>
                <tr>
                    <th>Titre</th>
                    <td>{{ evaluation.title }}</td>
                </tr>
                <tr>
                    <th>Description</th>
                    <td>{{ evaluation.description }}</td>
                </tr>
                <tr>
                    <th>Score Maximum</th>
                    <td>{{ evaluation.maxScore }}</td>
                </tr>
                <tr>
                    <th>Date Limite</th>
                    <td>{{ evaluation.deadline ? evaluation.deadline|date('d/m/Y H:i') : '' }}</td>
                </tr>
                <tr>
                    <th>Cours</th>
                    <td>{{ evaluation.cours }}</td>
                </tr>
            </tbody>
        </table>

        <!-- Questions -->
        {% if questions|length > 0 %}
            <h2 class="mt-4">Questions</h2>
            <form method="post">
                {% for question in questions %}
                    <div class="card mb-3">
                        <div class="card-body">
                            <h5 class="card-title">Question {{ question.ordreQuestion }}</h5>
                            <p class="card-text">{{ question.enonce }}</p>
                            
                            {% if question.codeSnippet %}
                                <div class="code-block">
                                    <pre><code class="language-{{ question.programmingLanguage|default('plaintext') }}">{{ question.codeSnippet }}</code></pre>
                                </div>
                            {% endif %}

                            <div class="form-group">
                                <label for="response_{{ question.id }}">Votre réponse:</label>
                                <textarea class="form-control" id="response_{{ question.id }}" 
                                    name="responses[{{ question.id }}]" rows="3" required></textarea>
                            </div>
                            <small class="text-muted">Points: {{ question.point }}</small>
                        </div>
                    </div>
                {% endfor %}
                <button type="submit" class="btn btn-primary">Soumettre les réponses</button>
            </form>
        {% else %}
            <div class="alert alert-info mt-4">
                Aucune question n'est disponible pour cette évaluation.
                <a href="{{ path('app_evaluation_indexetudiant') }}" class="btn btn-link">Retour à la liste</a>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.24.1/prism.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.24.1/components/prism-java.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.24.1/components/prism-python.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.24.1/components/prism-javascript.min.js"></script>
{% endblock %}
