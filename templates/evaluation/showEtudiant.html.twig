{% extends 'base.html.twig' %}

{% block title %}Evaluation{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="{{ asset('assets/css/showevaluation.css') }}">
{% endblock %}

{% block body %}
    <div class="form-container">
        <h1>Evaluation</h1>

        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ evaluation.id }}</td>
                </tr>
                <tr>
                    <th>Title</th>
                    <td>{{ evaluation.title }}</td>
                </tr>
                <tr>
                    <th>Description</th>
                    <td>{{ evaluation.description }}</td>
                </tr>
                <tr>
                    <th>Max Score</th>
                    <td>{{ evaluation.maxScore }}</td>
                </tr>
                <tr>
                    <th>Created At</th>
                    <td>{{ evaluation.createAt ? evaluation.createAt|date('Y-m-d H:i:s') : '' }}</td>
                </tr>
                <tr>
                    <th>Deadline</th>
                    <td>{{ evaluation.deadline ? evaluation.deadline|date('Y-m-d H:i:s') : '' }}</td>
                </tr>
                <tr>
                    <th>Number of Courses</th>
                    <td>{{ evaluation.cours|length }}</td> <!-- Si 'cours' est une collection -->
                </tr>
            </tbody>
        </table>

        <!-- Bouton Evaluate -->
        <div class="text-center mt-4">
            {% if evaluation.questions|length > 0 %}
    <a href="{{ path('app_reponse_new', {'questionId': evaluation.questions|first.id}) }}" class="btn btn-primary">Evaluate</a>
     {% else %}
    <p>No questions available for this evaluation.</p>
{% endif %}
        </div>

    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
