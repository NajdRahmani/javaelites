{% block title %}Mes réponses aux évaluations{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">Mes réponses aux évaluations</h1>

    {% if evaluations is empty %}
        <div class="alert alert-info">
            Vous n'avez pas encore répondu à des évaluations.
        </div>
    {% else %}
        {% for evaluation in evaluations %}
            <div class="card mb-4">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h2 class="h4 mb-0">{{ evaluation.title }}</h2>
                    <span class="badge bg-light text-primary">
                        Date limite : {{ evaluation.deadline|date('d/m/Y H:i') }}
                    </span>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-3">{{ evaluation.description }}</p>
                    
                    <div class="accordion" id="accordion-{{ evaluation.id }}">
                        {% for question in evaluation.Questions %}
                            <div class="accordion-item">
                                <h3 class="accordion-header" id="heading-{{ question.id }}">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" 
                                            data-bs-target="#collapse-{{ question.id }}" aria-expanded="false">
                                        Question {{ loop.index }} ({{ question.point }} points)
                                    </button>
                                </h3>
                                <div id="collapse-{{ question.id }}" class="accordion-collapse collapse" 
                                     data-bs-parent="#accordion-{{ evaluation.id }}">
                                    <div class="accordion-body">
                                        <p><strong>Question :</strong> {{ question.text }}</p>
                                        {% set userReponse = null %}
                                        {% for reponse in question.reponses %}
                                            {% if reponse.userId == 12346 %}
                                                {% set userReponse = reponse %}
                                            {% endif %}
                                        {% endfor %}
                                        
                                        {% if userReponse %}
                                            <div class="mt-3">
                                                <p><strong>Votre réponse :</strong></p>
                                                <div class="border p-3 rounded bg-light">
                                                    {{ userReponse.text }}
                                                </div>
                                                {% if userReponse.note is not null %}
                                                    <div class="mt-2">
                                                        <span class="badge bg-{% if userReponse.note >= question.point * 0.7 %}success{% elseif userReponse.note >= question.point * 0.5 %}warning{% else %}danger{% endif %}">
                                                            Note : {{ userReponse.note }}/{{ question.point }} points
                                                        </span>
                                                    </div>
                                                {% else %}
                                                    <div class="mt-2">
                                                        <span class="badge bg-warning">En attente de correction</span>
                                                    </div>
                                                {% endif %}
                                            </div>
                                        {% else %}
                                            <div class="alert alert-warning">
                                                Vous n'avez pas répondu à cette question.
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="card-footer">
                    <div class="d-flex justify-content-between align-items-center">
                        <a href="{{ path('app_evaluation_show', {'id': evaluation.id}) }}" class="btn btn-primary">
                            <i class="fas fa-eye"></i> Voir l'évaluation complète
                        </a>
                        {% set totalScore = 0 %}
                        {% set maxScore = 0 %}
                        {% for question in evaluation.Questions %}
                            {% set maxScore = maxScore + question.point %}
                            {% for reponse in question.reponses %}
                                {% if reponse.userId == 12346 and reponse.note is not null %}
                                    {% set totalScore = totalScore + reponse.note %}
                                {% endif %}
                            {% endfor %}
                        {% endfor %}
                        <span class="badge bg-{% if totalScore >= maxScore * 0.7 %}success{% elseif totalScore >= maxScore * 0.5 %}warning{% else %}danger{% endif %} p-2">
                            Score total : {{ totalScore }}/{{ maxScore }} points
                        </span>
                    </div>
                </div>
            </div>
        {% endfor %}
    {% endif %}

    <a href="{{ path('app_evaluation_index_etudiant') }}" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Retour aux évaluations
    </a>
</div>
{% endblock %}

