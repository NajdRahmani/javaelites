{% extends 'base.html.twig' %}

{% block title %}Evaluation{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css">
       <link rel="stylesheet" href="{{ asset('assets/css/showevaluation.css') }}">

{% endblock %}

{% block body %}
    <div class="form-container">
        <h1>Evaluation</h1>

        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ evaluation.id }}</td>
                </tr>
                <tr>
                    <th>Title</th>
                    <td>{{ evaluation.title }}</td>
                </tr>
                <tr>
                    <th>Description</th>
                    <td>{{ evaluation.description }}</td>
                </tr>
                <tr>
                    <th>Max Score</th>
                    <td>{{ evaluation.maxScore }}</td>
                </tr>
                <tr>
                    <th>Create At</th>
                    <td>{{ evaluation.createAt ? evaluation.createAt|date('Y-m-d H:i:s') : '' }}</td>
                </tr>
                <tr>
                    <th>Deadline</th>
                    <td>{{ evaluation.deadline ? evaluation.deadline|date('Y-m-d H:i:s') : '' }}</td>
                </tr>
                <tr>
                    <th>Number of Courses</th>
                    <td>{{ evaluation.cours }}</td>
                </tr>
            </tbody>
        </table>

        <div class="form-group text-center">
            <a href="{{ path('app_evaluation_index') }}" class="btn btn-secondary">Back to List</a>
            <a href="{{ path('app_evaluation_edit', {'id': evaluation.id}) }}" class="btn btn-warning">Edit</a>
        </div>

        {{ include('evaluation/_delete_form.html.twig') }}
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
