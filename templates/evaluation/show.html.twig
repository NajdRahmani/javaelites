{% extends 'base.html.twig' %}

{% block title %}Détails de l'évaluation{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Détails de l'évaluation</h1>

        <table class="table">
            <tbody>
                <tr>
                    <th>Titre</th>
                    <td>{{ evaluation.title }}</td>
                </tr>
                <tr>
                    <th>Description</th>
                    <td>{{ evaluation.description }}</td>
                </tr>
                <tr>
                    <th>Score Maximum</th>
                    <td>{{ evaluation.maxScore }}</td>
                </tr>
                <tr>
                    <th>Date limite</th>
                    <td>{{ evaluation.deadline ? evaluation.deadline|date('Y-m-d') : '' }}</td>
                </tr>
            </tbody>
        </table>

        <div class="mt-4">
            <a href="{{ path('app_evaluation_statistics', {'id': evaluation.id}) }}" class="btn btn-primary">
                <i class="fas fa-chart-bar"></i> Voir les statistiques
            </a>
            
            <a href="{{ path('app_evaluation_editenseignant', {'id': evaluation.id}) }}" class="btn btn-warning">
                <i class="fas fa-edit"></i> Modifier
            </a>

            <a href="{{ path('app_evaluation_indexenseignant') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
        </div>
    </div>
{% endblock %}
