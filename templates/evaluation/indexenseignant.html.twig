{% extends 'base2.html.twig' %}

{% block title %}Liste des Évaluations{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('assets/css/indexevaluation.css') }}">
{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-4">Liste des Évaluations</h1>

        <div class="text-end mb-3">
            <a href="{{ path('app_evaluation_new_enseignant') }}" class="btn btn-success">
                <i class="fas fa-plus"></i> Nouvelle Évaluation
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Titre</th>
                        <th>Description</th>
                        <th>Score Maximum</th>
                        <th>Date Limite</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for evaluation in evaluations %}
                    <tr>
                        <td>{{ evaluation.title }}</td>
                        <td>{{ evaluation.description }}</td>
                        <td>{{ evaluation.maxScore }}</td>
                        <td>{{ evaluation.deadline ? evaluation.deadline|date('Y-m-d H:i:s') : '' }}</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a href="{{ path('app_question_index', {'evaluationId': evaluation.id}) }}" class="btn btn-primary btn-sm">
                                    <i class="fas fa-eye"></i> Voir
                                </a>
                                <a href="{{ path('app_evaluation_edit', {'id': evaluation.id}) }}" class="btn btn-warning btn-sm">
                                    <i class="fas fa-edit"></i> Modifier
                                </a>
                                <a href="{{ path('app_evaluation_corriger', {'id': evaluation.id}) }}" class="btn btn-info btn-sm">
                                    <i class="fas fa-check-circle"></i> Corriger
                                </a>
                                
                            </div>

                            {{include ('evaluation/_delete_form.html.twig') }}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center">Aucune évaluation trouvée</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
