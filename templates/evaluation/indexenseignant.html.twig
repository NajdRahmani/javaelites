{% extends 'base3.html.twig' %}

{% block title %}Liste des Évaluations{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .evaluation-list {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 2rem;
        }
        .table th {
            background-color: #f8f9fa;
        }
        .btn-group {
            display: flex;
            gap: 0.5rem;
        }
        .evaluation-title {
            max-width: 200px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="evaluation-list">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Liste des Évaluations</h1>
            <a href="{{ path('app_evaluation_newenseignant') }}" class="btn btn-success">
                <i class="fas fa-plus"></i> Nouvelle Évaluation
            </a>
        </div>

        <div class="card">
            <div class="card-body">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Titre</th>
                            <th>Score Maximum</th>
                            <th>Date de Création</th>
                            <th>Date Limite</th>
                            <th>Cours</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for evaluation in evaluations %}
                        <tr>
                            <td>{{ evaluation.id }}</td>
                            <td>
                                <div class="evaluation-title" title="{{ evaluation.title }}">
                                    {{ evaluation.title }}
                                </div>
                            </td>
                            <td>{{ evaluation.maxScore }}</td>
                            <td>{{ evaluation.createAt ? evaluation.createAt|date('d/m/Y H:i') : '' }}</td>
                            <td>{{ evaluation.deadline ? evaluation.deadline|date('d/m/Y H:i') : '' }}</td>
                            <td>{{ evaluation.cours }}</td>
                            <td>
                                <div class="btn-group">
                                    <a href="{{ path('app_question_index', {'evaluationId': evaluation.id}) }}" 
                                       class="btn btn-info btn-sm">
                                        <i class="fas fa-eye"></i> Questions
                                    </a>
                                    <a href="{{ path('app_evaluation_editenseignant', {'id': evaluation.id}) }}" 
                                       class="btn btn-warning btn-sm">
                                        <i class="fas fa-edit"></i> Modifier
                                    </a>
                                    <a href="{{ path('evaluation_correctenseignant', {'id': evaluation.id}) }}" 
                                       class="btn btn-success btn-sm">
                                        <i class="fas fa-check-circle"></i> Corriger
                                    </a>
                                    {% include 'evaluation/_delete_form.html.twig' with {'evaluation': evaluation} %}

                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center">Aucune évaluation trouvée</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {% if app.session.flashBag.has('success') %}
        <div class="alert alert-success">
            {{ app.session.flashBag.get('success')[0] }}
        </div>
    {% endif %}
{% endblock %}
