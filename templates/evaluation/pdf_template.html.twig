<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Résultats d'Évaluation</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 40px;
        }
        .header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #333;
            padding-bottom: 20px;
        }
        .student-info {
            margin-bottom: 20px;
        }
        .evaluation-info {
            margin-bottom: 30px;
        }
        .question {
            margin-bottom: 15px;
            padding: 10px;
            background-color: #f5f5f5;
        }
        .response {
            margin-left: 20px;
            margin-bottom: 10px;
        }
        .score {
            font-weight: bold;
            color: #2c3e50;
        }
        .total-score {
            text-align: right;
            font-size: 1.2em;
            margin-top: 20px;
            padding: 15px;
            background-color: #f9f9f9;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Résultats d'Évaluation</h1>
        <p>{{ evaluation.title }}</p>
        <p>Date: {{ date|date('d/m/Y') }}</p>
    </div>

    <div class="student-info">
        <h3>Informations de l'étudiant</h3>
        <p>Nom: {{ student.nom }}</p>
        <p>Prénom: {{ student.prenom }}</p>
    </div>

    <div class="evaluation-info">
        <h3>Description</h3>
        <p>{{ evaluation.description }}</p>

        <h3>Réponses et Notes</h3>
        {% for reponse in responses %}
            <div class="question">
                <p><strong>Question {{ loop.index }}:</strong> {{ reponse.question.enonce }}</p>
                <div class="response">
                    <p>Votre réponse: {{ reponse.text }}</p>
                    <p class="score">Note: {{ reponse.note }}/20</p>
                </div>
            </div>
        {% endfor %}

        <div class="total-score">
            <h3>Note Totale: {{ totalScore }}/20</h3>
        </div>
    </div>
</body>
</html>
