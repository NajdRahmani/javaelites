{% extends 'base.html.twig' %}

{% block title %}{{ evaluation.title }}{% endblock %}

{% block body %}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
    {% endfor %}

    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h1>{{ evaluation.title }}</h1>
        </div>
        <div class="card-body">
            <p>{{ evaluation.description }}</p>
            <p>Score maximum total : {{ evaluation.maxScore }} points</p>
        </div>
    </div>

    <h2>Liste des étudiants à corriger</h2>

    {% if etudiants is empty %}
        <div class="alert alert-info">
            Aucun étudiant n'a encore répondu à cette évaluation.
        </div>
    {% else %}
        {% for etudiant in etudiants %}
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">Étudiant ID: {{ etudiant.id }}</h5>
                    <a href="{{ path('app_evaluation_corriger_etudiant', {'id': evaluation.id, 'userId': etudiant.id}) }}" 
                       class="btn btn-primary w-100">
                        <i class="fas fa-check me-2"></i>Corriger les réponses
                    </a>
                </div>
            </div>
        {% endfor %}
    {% endif %}

    <div class="mt-4">
        <a href="{{ path('enseignant') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Retour à la liste
        </a>
    </div>
{% endblock %}
