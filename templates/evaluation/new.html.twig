{% extends 'base.html.twig' %}

{% block title %}Nouvelle Évaluation{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css">
    <style>
        .invalid-feedback {
            display: block !important;
            color: #ff0000;
            font-weight: 500;
            margin-top: 5px;
            font-size: 14px;
        }
        .form-control.is-invalid {
            border-color: #ff0000;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h1 class="h3 mb-0">Créer une nouvelle évaluation</h1>
            </div>
            <div class="card-body">
                {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                    <div class="form-group mb-3">
                        {{ form_label(form.title, 'Titre *') }}
                        {{ form_widget(form.title, {
                            'attr': {
                                'class': 'form-control' ~ (form_errors(form.title) ? ' is-invalid' : ''),
                                'placeholder': 'Entrez le titre de l\'évaluation'
                            }
                        }) }}
                        <div class="invalid-feedback">
                            {{ form_errors(form.title) }}
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        {{ form_label(form.description, 'Description *') }}
                        {{ form_widget(form.description, {
                            'attr': {
                                'class': 'form-control' ~ (form_errors(form.description) ? ' is-invalid' : ''),
                                'rows': 4,
                                'placeholder': 'Décrivez l\'évaluation'
                            }
                        }) }}
                        <div class="invalid-feedback">
                            {{ form_errors(form.description) }}
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        {{ form_label(form.max_score, 'Score Maximum *') }}
                        {{ form_widget(form.max_score, {
                            'attr': {
                                'class': 'form-control' ~ (form_errors(form.max_score) ? ' is-invalid' : ''),
                                'min': 0,
                                'placeholder': 'Entrez le score maximum'
                            }
                        }) }}
                        <div class="invalid-feedback">
                            {{ form_errors(form.max_score) }}
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        {{ form_label(form.deadline, 'Date Limite *') }}
                        {{ form_widget(form.deadline, {
                            'attr': {
                                'class': 'form-control' ~ (form_errors(form.deadline) ? ' is-invalid' : ''),
                                'type': 'date'
                            }
                        }) }}
                        <div class="invalid-feedback">
                            {{ form_errors(form.deadline) }}
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        {{ form_label(form.cours, 'Numéro du Cours') }}
                        {{ form_widget(form.cours, {
                            'attr': {
                                'class': 'form-control' ~ (form_errors(form.cours) ? ' is-invalid' : ''),
                                'min': 1,
                                'placeholder': 'Entrez le numéro du cours'
                            }
                        }) }}
                        <div class="invalid-feedback">
                            {{ form_errors(form.cours) }}
                        </div>
                    </div>

                    <p class="text-muted"><small>* Champs obligatoires</small></p>

                    <div class="d-flex justify-content-between">
                        <a href="{{ path('app_evaluation_index_enseignant') }}" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Retour
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Créer l'évaluation
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
