{# templates/evaluation/answer.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Répondre à l'évaluation{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h1 class="h3 mb-0">{{ evaluation.title }}</h1>
        </div>
        <div class="card-body">
            <p class="card-text">{{ evaluation.description }}</p>
            <p class="text-muted">Score maximum : {{ evaluation.maxScore }} points</p>
            
            <form action="{{ path('app_reponse_submit', {'evaluation_id': evaluation.id}) }}" method="POST">
                {% for question in evaluation.questions %}
                    <div class="mb-4">
                        <label class="form-label fw-bold">
                            Question {{ loop.index }} ({{ question.point }} points)
                        </label>
                        <p class="mb-2">{{ question.text }}</p>
                        <textarea 
                            name="reponses[{{ question.id }}]" 
                            class="form-control" 
                            rows="3" 
                            required 
                            placeholder="Votre réponse..."
                        ></textarea>
                    </div>
                {% endfor %}

                <div class="d-flex justify-content-between mt-4">
                    <a href="{{ path('app_evaluation_index_etudiant') }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Retour
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-paper-plane"></i> Soumettre mes réponses
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
