{% block javascripts %}
        {{ parent() }}
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                // Initialisation de TinyMCE
                tinymce.init({
                    selector: '.tinymce-editor',
                    plugins: 'code codesample equations lists link image table',
                    toolbar: 'undo redo | blocks | bold italic | alignleft aligncenter alignright | indent outdent | bullist numlist | code codesample | equations',
                    codesample_languages: [
                        {text: 'HTML/XML', value: 'markup'},
                        {text: 'JavaScript', value: 'javascript'},
                        {text: 'CSS', value: 'css'},
                        {text: 'PHP', value: 'php'},
                        {text: 'Python', value: 'python'},
                        {text: 'Java', value: 'java'},
                        {text: 'C', value: 'c'},
                        {text: 'SQL', value: 'sql'}
                    ],
                    setup: function(editor) {
                        editor.ui.registry.addButton('equations', {
                            text: '∑',
                            tooltip: 'Insert Math Equation',
                            onAction: function() {
                                editor.insertContent('\\(\\)');
                            }
                        });
                    }
                });

                // Initialisation de Highlight.js
                document.querySelectorAll('pre code').forEach((block) => {
                    hljs.highlightBlock(block);
                });

                // Initialisation de MathJax
                MathJax.Hub.Config({
                    tex2jax: {
                        inlineMath: [['\\(','\\)']],
                        displayMath: [['\\[','\\]']],
                        processEscapes: true
                    }
                });

                // Initialisation de SortableJS pour les questions
                const questionsList = document.querySelector('.sortable-questions');
                if (questionsList) {
                    new Sortable(questionsList, {
                        animation: 150,
                        ghostClass: 'sortable-ghost',
                        onEnd: function(evt) {
                            // Mise à jour de l'ordre des questions
                            const questions = Array.from(questionsList.children);
                            const orderedIds = questions.map(q => q.dataset.questionId);
                            
                            // Envoi de l'ordre au serveur
                            fetch('/question/reorder', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                },
                                body: JSON.stringify({
                                    questionIds: orderedIds
                                })
                            });
                        }
                    });
                }

                // Système de détection de plagiat simple
                function checkPlagiarism(text) {
                    // Vérification basique de copier-coller
                    let lastPaste = localStorage.getItem('lastPaste');
                    if (lastPaste && text.includes(lastPaste)) {
                        alert('Attention : Contenu potentiellement copié détecté !');
                    }
                    localStorage.setItem('lastPaste', text);

                    // Vérification du temps de réponse
                    const startTime = localStorage.getItem('startTime');
                    const endTime = new Date().getTime();
                    const timeSpent = (endTime - startTime) / 1000; // en secondes

                    if (timeSpent < 30 && text.length > 200) {
                        alert('Attention : Réponse suspecte - temps de réponse trop court !');
                    }
                }

                // Écouteur d'événements pour le copier-coller
                document.addEventListener('paste', function(e) {
                    if (e.target.classList.contains('answer-input')) {
                        setTimeout(() => checkPlagiarism(e.target.value), 100);
                    }
                });
            });
        </script>
    {% endblock %}
</body>
</html>
